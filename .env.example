# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# RGD LUXE ADMIN & SECURITY CONFIGURATION (BACKEND SECRETS ONLY)
# For deployed / production builds, configure these in AI Studio Secrets
# (never commit .env files or expose backend secrets with VITE_).
# ------------------------------------------------------------------
ADMIN_EMAIL="[ENTER YOUR ADMIN EMAIL HERE]"
ADMIN_PASSWORD="[ENTER YOUR NEW STRONG ADMIN PASSWORD HERE]"
ADMIN_RECOVERY_EMAIL="[ENTER YOUR PRIVATE RECOVERY EMAIL HERE]"

# ------------------------------------------------------------------
# EMAIL DELIVERY SERVICE FOR ADMIN PASSWORD RECOVERY OTP
# Configure EITHER Resend API OR SMTP (Nodemailer) in AI Studio Secrets.
# If neither is configured, OTP recovery returns an explicit configuration error.
# ------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="RGD LUXE Security <no-reply@yourdomain.com>"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# ------------------------------------------------------------------
# FIREBASE ADMIN SDK (RGD-LUXE3 FIRESTORE BACKEND PERSISTENCE)
# Required in production AI Studio Secrets / Cloud Run Secrets (NEVER prefix VITE_).
# Production startup fails closed if missing or unreachable.
# ------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=""
FIREBASE_DATABASE_ID="(default)"
